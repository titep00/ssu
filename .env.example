# ── 데이터베이스 (Neon Postgres) ───────────────────────────────
# Vercel에서 Neon 연동을 설치하면 자동으로 주입됩니다.
# 로컬에서는 Neon 콘솔의 연결 문자열(pooled)을 그대로 넣으세요.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ── 세션 서명 비밀키 ───────────────────────────────────────────
# 로그인 세션 쿠키를 안전하게 서명하는 데 쓰입니다. 16자 이상의 무작위 문자열.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="여기에_32자_이상_무작위_문자열을_넣으세요"

# ── 관리자(선생님) 비밀번호 ────────────────────────────────────
# 선생님이 관리자 페이지에 로그인할 때 사용하는 비밀번호입니다. 반드시 바꾸세요.
ADMIN_PASSWORD="datateacher2026!"

# ── 허용 반 코드 (선택) ────────────────────────────────────────
# 쉼표로 구분해 학생이 입력할 수 있는 반 코드를 제한합니다.
# 비워두면 어떤 반 코드든 허용됩니다. 예: "1-1,1-2,1-3"
CLASS_CODES=""
